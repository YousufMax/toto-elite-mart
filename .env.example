# ==========================================
# TOTO ELITE MART — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (PostgreSQL)
# Can use Supabase (Free Tier), Neon Serverless Postgres, or Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toto_elite_mart?schema=public"
# DIRECT_URL is optional if using Supabase connection pooler
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/toto_elite_mart"

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="toto_elite_mart_super_secure_jwt_secret_key_2026_xyz"
SESSION_MAX_AGE_DAYS=7

# 3. APPLICATION
NEXT_PUBLIC_APP_NAME="Toto Elite Mart"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="BDT"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"

# Delivery Fees in BDT
NEXT_PUBLIC_DELIVERY_FEE_INSIDE_DHAKA=60
NEXT_PUBLIC_DELIVERY_FEE_OUTSIDE_DHAKA=120

# 4. IMAGEKIT FREE CDN & IMAGE HOSTING
# Sign up at https://imagekit.io (Free plan includes 20GB bandwidth & 20GB media storage)
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# 5. TELEGRAM BOT NOTIFICATIONS
# Create bot via @BotFather, get Chat ID via @userinfobot or group ID
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
TELEGRAM_ENABLE_ALERTS=true

# 6. GOOGLE SHEETS API INTEGRATION
# Google Cloud Service Account credentials (server-side only)
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_spreadsheet_id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# Note: Google private key format (replace \n with real newlines or keep escaped)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SYNC_INTERVAL_HOURS=6
