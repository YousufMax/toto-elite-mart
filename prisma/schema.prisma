// Prisma schema for Toto Elite Mart
// Production-grade PostgreSQL schema with full relational integrity, indexes, and audit logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ORDER_MANAGER
  INVENTORY_MANAGER
  ACCOUNTANT
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK_TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED_BDT
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE_DEDUCTION
  MANUAL_ADJUSTMENT
  RETURN_RESTOCK
  ORDER_CANCEL_RELEASE
  DAMAGE_WRITE_OFF
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role        @default(STAFF)
  status        UserStatus  @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  expenses           Expense[]
  assignedOrders     Order[]             @relation("OrderAssignee")
  recordedPayments   Payment[]           @relation("PaymentRecorder")

  @@index([email])
  @@index([role])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, SYNC
  entityType String   // ORDER, PRODUCT, INVENTORY, EXPENSE, USER, SETTING
  entityId   String?
  beforeState Json?
  afterState  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([slug])
  @@index([isActive])
}

model Product {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  sku                String        @unique
  description        String?
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchaseCost       Decimal       @default(0.00) @db.Decimal(12, 2)
  sellingPrice       Decimal       @db.Decimal(12, 2)
  salePrice          Decimal?      @db.Decimal(12, 2)
  stockQuantity      Int           @default(0)
  lowStockThreshold  Int           @default(5)
  status             ProductStatus @default(ACTIVE)
  isFeatured         Boolean       @default(false)
  tags               String?
  seoTitle           String?
  seoDescription     String?
  isArchived         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  images             ProductImage[]
  colorVariants      ColorVariant[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([sku])
  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isArchived])
}

model ColorVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String      // e.g. "Matte Black", "Pearl White"
  colorCode     String      // e.g. "#111827"
  price         Decimal?    @db.Decimal(12, 2) // Custom variant price (optional: inherits product price if null)
  imageUrl      String?     // Associated image URL from gallery
  stockQuantity Int         @default(0)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orderItems    OrderItem[]

  @@index([productId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  fileId    String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([isPrimary])
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  fileId    String?
  targetUrl String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  discountType     DiscountType @default(PERCENTAGE)
  discountValue    Decimal      @db.Decimal(12, 2)
  minOrderValue    Decimal      @default(0.00) @db.Decimal(12, 2)
  maxDiscountValue Decimal?     @db.Decimal(12, 2)
  usageLimit       Int?
  timesUsed        Int          @default(0)
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([code])
  @@index([isActive])
}

model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  email     String?
  address   String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([phone])
}

model Order {
  id                 String        @id @default(uuid())
  orderNumber        String        @unique // e.g. TEM-2026-10001
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerPhone      String
  deliveryAddress    String
  deliveryCity       String        @default("Dhaka")
  deliveryZone       String?       // "Inside Dhaka" or "Outside Dhaka"
  subtotal           Decimal       @db.Decimal(12, 2)
  discount           Decimal       @default(0.00) @db.Decimal(12, 2)
  couponCode         String?
  deliveryFee        Decimal       @default(60.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(COD)
  paymentStatus      PaymentStatus @default(UNPAID)
  orderStatus        OrderStatus   @default(PENDING)
  notes              String?
  internalNotes      String?
  assignedEmployeeId String?
  assignedEmployee   User?         @relation("OrderAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  isDeleted          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([orderNumber])
  @@index([customerPhone])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([isDeleted])
  @@index([createdAt])
}

model OrderItem {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName   String
  sku           String
  selectedColor String?       // Immutable color snapshot e.g. "Matte Black"
  variantId     String?
  variant       ColorVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unitPrice     Decimal       @db.Decimal(12, 2)
  purchaseCost  Decimal       @default(0.00) @db.Decimal(12, 2)
  quantity      Int
  totalPrice    Decimal       @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(COD)
  transactionId String?
  status        PaymentStatus @default(PAID)
  notes         String?
  recordedById  String?
  recordedBy    User?         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([recordedById])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementType InventoryMovementType
  quantity     Int
  previousStock Int
  newStock     Int
  reason       String?
  referenceId  String?
  employeeId   String?
  employee     User?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  @@index([productId])
  @@index([employeeId])
  @@index([createdAt])
}

model Expense {
  id            String        @id @default(uuid())
  expenseDate   DateTime      @default(now())
  category      String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(COD)
  receiptUrl    String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([expenseDate])
  @@index([isDeleted])
}

model NotificationOutbox {
  id          String             @id @default(uuid())
  eventType   String
  channel     String             @default("TELEGRAM")
  recipient   String
  payload     Json
  status      NotificationStatus @default(PENDING)
  retryCount  Int                @default(0)
  lastError   String?
  nextRetryAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())

  @@index([status])
  @@index([createdAt])
}

model SyncRun {
  id               String     @id @default(uuid())
  syncType         String
  status           SyncStatus @default(IDLE)
  recordsProcessed Int        @default(0)
  recordsFailed    Int        @default(0)
  errorMessage     String?
  metadata         Json?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
